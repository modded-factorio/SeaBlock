{
  "name": "SeaBlock-wiki",
  "version": "1.0.0",
  "description": "SeaBlock Wiki with VitePress and browser-based WYSIWYG editing",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --host 0.0.0.0",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "build:browser": "vite build --config vite.extracted.config.js",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md --fix",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mdit-vue/plugin-component": "^2.1.4",
    "@mdit-vue/plugin-frontmatter": "^2.1.4",
    "@mdit-vue/plugin-headers": "^2.1.4",
    "@mdit-vue/plugin-title": "^2.1.4",
    "@mdit-vue/plugin-toc": "^2.1.4",
    "@mdit-vue/shared": "^2.1.4",
    "@vue/compiler-sfc": "^3.3.8",
    "@vueuse/core": "^10.5.0",
    "dompurify": "^3.0.5",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-cjk-friendly": "^1.3.0",
    "markdown-it-container": "^3.0.0",
    "markdown-it-emoji": "^2.0.2",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-table-of-contents": "^0.6.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^9.1.6",
    "save-dev": "^0.0.1-security",
    "shiki": "^2.5.0",
    "vitepress": "^1.6.4",
    "vue": "^3.3.8"
  },
  "devDependencies": {
    "@mdit-vue/plugin-sfc": "^2.1.4",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.9.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/tsconfig": "^0.4.0",
    "assert": "^2.1.0",
    "browserify-fs": "^1.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.1",
    "eslint": "^8.53.0",
    "eslint-plugin-vue": "^9.18.1",
    "events": "^3.3.0",
    "fs.promises": "^0.1.2",
    "https-browserify": "^1.0.0",
    "markdown-it-github-alerts": "^1.0.0",
    "net-browserify": "^0.2.4",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.1.0",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "timers-browserify": "^2.0.12",
    "tty-browserify": "^0.0.1",
    "typescript": "^5.2.2",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue-tsc": "^1.8.22"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "wiki",
    "vitepress",
    "wysiwyg",
    "SeaBlock",
    "vue",
    "markdown"
  ],
  "author": "SeaBlock Wiki Team",
  "license": "MIT"
}
